NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/food-app
JWT_SECRET=replace-with-a-long-random-secret
CAPTCHA_SECRET=replace-with-a-different-long-random-secret
CLIENT_URL=http://localhost:3000
# Optional comma-separated additional browser origins.
# CORS_ORIGINS=http://localhost:3000,https://app.example.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Set to 1 when deploying behind one trusted reverse proxy.
# TRUST_PROXY=1
