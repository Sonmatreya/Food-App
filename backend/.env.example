NODE_ENV=development
PORT=5000
# Mock-only checkout simulation; no real payment provider or money transfer.
# Local development is enabled by default; set true on Render only for project demos.
DEMO_PAYMENTS_ENABLED=true
MONGO_URI=mongodb://127.0.0.1:27017/food-app
JWT_SECRET=replace-with-a-long-random-secret
CAPTCHA_SECRET=replace-with-a-different-long-random-secret
CLIENT_URL=http://localhost:3000
# Optional comma-separated additional browser origins.
# CORS_ORIGINS=http://localhost:3000,https://app.example.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Set to 1 when deploying behind one trusted reverse proxy.
# TRUST_PROXY=1

# PayU hosted checkout is restricted to test mode in this project.
PAYU_MODE=test
PAYU_KEY=your_test_key_here
PAYU_SALT=your_test_salt_here
PAYU_CALLBACK_URL=https://food-app-backend-lxic.onrender.com/api/payments/payu/return

# Optional direct password reset for a demo account. On Render, set DEMO_RESET_EMAIL to the one dedicated demo account email.
# Enable only if this deployment is a public demo and you accept that anyone can reset that demo account's password.
ENABLE_DEMO_PASSWORD_RESET=true
DEMO_RESET_EMAIL=demo@example.com

# SMTP settings for password reset emails (required to enable recovery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=Food-App <your-sender-email@gmail.com>
